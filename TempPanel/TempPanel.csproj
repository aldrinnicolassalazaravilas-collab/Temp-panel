<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF para la ventana nativa; WinForms solo para NotifyIcon (bandeja) -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>TempPanel</AssemblyTitle>
    <AssemblyCompany>TempPanel</AssemblyCompany>
    <AssemblyProduct>TempPanel</AssemblyProduct>
    <AssemblyDescription>Monitor de hardware en tiempo real</AssemblyDescription>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>
    <Version>2.5.0</Version>
    <Copyright>Copyright © 2026 TempPanel</Copyright>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Evita consola: WinExe ya lo hace. Single-file autocontenido se activa en publish -->
    <!-- Menos RAM: GC de estación de trabajo no concurrente (app de UI pequeña) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Símbolos dentro del propio exe: rastro de errores con número de línea
         y sin archivo .pdb suelto en la carpeta publicada. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- 1.0.2957+ incluye WebView2CompositionControl (transparencia real en Win11) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frontend embebido: se copia junto al exe -->
    <Content Include="Frontend\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Utillaje de desarrollo: nunca se distribuye con la app. -->
    <Content Remove="Frontend\_preview.html" />
  </ItemGroup>

</Project>
