<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF para la ventana nativa; WinForms solo para NotifyIcon (bandeja) -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>TempPanel</AssemblyTitle>
    <AssemblyCompany>TempPanel</AssemblyCompany>
    <AssemblyProduct>TempPanel</AssemblyProduct>
    <AssemblyDescription>Monitor de hardware en tiempo real</AssemblyDescription>
    <AssemblyVersion>1.2.10.0</AssemblyVersion>
    <FileVersion>1.2.10.0</FileVersion>
    <Version>1.2.10</Version>
    <Copyright>Copyright © 2026 TempPanel</Copyright>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Evita consola: WinExe ya lo hace. Single-file autocontenido se activa en publish -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frontend embebido: se copia junto al exe -->
    <Content Include="Frontend\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
