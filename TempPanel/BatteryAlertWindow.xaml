<Window x:Class="TempPanel.BatteryAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TempPanel — Batería al 80 %" SizeToContent="WidthAndHeight"
        Width="460" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#131A24" Topmost="True">
    <Border BorderBrush="#22D3EE" BorderThickness="1" CornerRadius="10" Margin="12" Padding="20">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="TempPanel — Batería al 80 %"
                       Foreground="#22D3EE" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="BodyText" Foreground="#E6EDF6" FontSize="14" TextWrapping="Wrap" MaxWidth="400"/>
            <TextBlock Foreground="#8B98AD" FontSize="11" TextWrapping="Wrap" MaxWidth="400" Margin="0,10,0,0">
                Aviso informativo: TempPanel no detiene la carga física de la batería, solo te avisa.
            </TextBlock>
            <Button x:Name="OkButton" Content="OK" Width="120" Height="34" Margin="0,16,0,0"
                    HorizontalAlignment="Right" Background="#2F7BFF" Foreground="White"
                    FontWeight="Bold" Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
