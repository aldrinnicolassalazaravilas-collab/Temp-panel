<Window x:Class="TempPanel.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TempPanel Mini" Width="340" Height="216"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Border x:Name="Shell" Margin="10" CornerRadius="18" BorderThickness="1" BorderBrush="#3A4E74">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C416213A" Offset="0"/>
                <GradientStop Color="#D20A101E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Rectangle Height="1" VerticalAlignment="Top" Margin="16,0,16,0" Opacity="0.75">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0022D3EE" Offset="0"/>
                        <GradientStop Color="#8822D3EE" Offset="0.5"/>
                        <GradientStop Color="#004F8CFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        <Grid Margin="13,10,13,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera (arrastrable) -->
            <DockPanel Grid.Row="0" MouseLeftButtonDown="Bar_Drag">
                <TextBlock Text="◈ TempPanel" Foreground="#22D3EE" FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="PinButton" Content="📌" Width="27" Height="24" Margin="0,0,3,0"
                            Background="Transparent" Foreground="#AFC2E0" BorderThickness="0" FontSize="11"
                            Cursor="Hand" Click="PinButton_Click" ToolTip="Fijar siempre encima"/>
                    <Button x:Name="ExpandButton" Content="⤢" Width="27" Height="24" Margin="0,0,3,0"
                            Background="Transparent" Foreground="#AFC2E0" BorderThickness="0" FontSize="13"
                            Cursor="Hand" Click="ExpandButton_Click" ToolTip="Ampliar / reducir"/>
                    <Button Content="✕" Width="27" Height="24"
                            Background="Transparent" Foreground="#AFC2E0" BorderThickness="0" FontSize="11"
                            Cursor="Hand" Click="CloseButton_Click" ToolTip="Volver a la ventana principal"/>
                </StackPanel>
            </DockPanel>

            <!-- Temperatura grande + resumen -->
            <Grid Grid.Row="1" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TempText" Grid.Column="0" Text="— °C" Foreground="#EEF4FF"
                           FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="SourceText" Grid.Column="1" Text="" Foreground="#5F7397"
                           FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"
                           Margin="8,0,8,5"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadText" Text="CPU —" Foreground="#9FB2D4" FontSize="11"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BatText" Text="Bat —" Foreground="#9FB2D4" FontSize="11"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- Chips extra (solo en modo ampliado) -->
            <WrapPanel x:Name="StatsPanel" Grid.Row="2" Margin="0,2,0,6" Visibility="Collapsed">
                <Border Background="#182541" CornerRadius="10" Padding="9,5" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="RAM" Foreground="#7C90B5" FontSize="9"/>
                        <TextBlock x:Name="RamText" Text="—" Foreground="#A78BFA" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#182541" CornerRadius="10" Padding="9,5" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="GPU" Foreground="#7C90B5" FontSize="9"/>
                        <TextBlock x:Name="GpuText" Text="—" Foreground="#F472B6" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#182541" CornerRadius="10" Padding="9,5" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Potencia" Foreground="#7C90B5" FontSize="9"/>
                        <TextBlock x:Name="PwrText" Text="—" Foreground="#FBBF24" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#182541" CornerRadius="10" Padding="9,5">
                    <StackPanel>
                        <TextBlock Text="Temp sesión (mín–máx)" Foreground="#7C90B5" FontSize="9"/>
                        <TextBlock x:Name="SessText" Text="—" Foreground="#22D3EE" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Minigráfico -->
            <Canvas x:Name="Chart" Grid.Row="3" Margin="0,2,0,2"
                    MouseLeftButtonDown="Bar_Drag" ClipToBounds="True"
                    ToolTip="Se suaviza la curva; pasa el ratón por las series para ver la leyenda."/>

            <!-- Leyenda conmutable -->
            <WrapPanel x:Name="Legend" Grid.Row="4" Orientation="Horizontal" Margin="0,2,0,0"/>
        </Grid>
        </Grid>
    </Border>
</Window>
