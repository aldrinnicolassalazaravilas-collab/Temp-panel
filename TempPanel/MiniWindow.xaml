<Window x:Class="TempPanel.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TempPanel Mini" Width="300" Height="212"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Background="#131A24" WindowStartupLocation="Manual">
    <Border BorderBrush="#22D3EE" BorderThickness="1" CornerRadius="8">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" MouseLeftButtonDown="Bar_Drag">
                <TextBlock Text="TempPanel" Foreground="#22D3EE" FontWeight="Bold" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="PinButton" Content="📌" Width="26" Height="22" Margin="0,0,4,0"
                            Background="Transparent" Foreground="#E6EDF6" BorderThickness="0" FontSize="11"
                            Click="PinButton_Click" ToolTip="Fijar encima de otras ventanas"/>
                    <Button Content="⤢" Width="26" Height="22" Margin="0,0,4,0"
                            Background="Transparent" Foreground="#E6EDF6" BorderThickness="0" FontSize="11"
                            Click="RestoreButton_Click" ToolTip="Volver a la ventana principal"/>
                    <Button Content="✕" Width="26" Height="22"
                            Background="Transparent" Foreground="#E6EDF6" BorderThickness="0" FontSize="11"
                            Click="CloseButton_Click" ToolTip="Volver a la ventana principal"/>
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,2">
                <TextBlock x:Name="TempText" Text="—" Foreground="#E6EDF6" FontSize="22" FontWeight="Bold" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LoadText" Text="—" Foreground="#8B98AD" FontSize="11"/>
                    <TextBlock x:Name="BatText" Text="—" Foreground="#8B98AD" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <Canvas x:Name="Chart" Grid.Row="2" Background="#0B1220"
                    MouseLeftButtonDown="Bar_Drag" ToolTip="Carga CPU (cian), temperatura (naranja), batería (verde) y RAM (lila)"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="●" Foreground="#22D3EE" FontSize="9" Margin="0,0,2,0"/><TextBlock Text="CPU" Foreground="#8B98AD" FontSize="9" Margin="0,0,8,0"/>
                <TextBlock Text="●" Foreground="#FB923C" FontSize="9" Margin="0,0,2,0"/><TextBlock Text="Temp" Foreground="#8B98AD" FontSize="9" Margin="0,0,8,0"/>
                <TextBlock Text="●" Foreground="#34D399" FontSize="9" Margin="0,0,2,0"/><TextBlock Text="Bat" Foreground="#8B98AD" FontSize="9" Margin="0,0,8,0"/>
                <TextBlock Text="●" Foreground="#A78BFA" FontSize="9" Margin="0,0,2,0"/><TextBlock Text="RAM" Foreground="#8B98AD" FontSize="9" Margin="0,0,8,0"/>
                <TextBlock Text="●" Foreground="#F472B6" FontSize="9" Margin="0,0,2,0"/><TextBlock Text="GPU" Foreground="#8B98AD" FontSize="9"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
